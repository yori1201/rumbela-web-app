# Salin file ini menjadi .env untuk pengembangan lokal.
# JANGAN commit file .env yang berisi nilai asli.
# Hanya variabel di bawah ini yang benar-benar dibaca kode saat ini.

# URL database Prisma (SQLite lokal).
DATABASE_URL="file:./dev.db"

# NODE_ENV dibaca kode (production/development); umumnya sudah diatur
# otomatis oleh Next.js, tidak wajib diisi di .env.
# NODE_ENV=development

# Catatan: Client ID Google Drive (GIS) TIDAK memakai env var,
# melainkan konstanta GDRIVE_CLIENT_ID di src/lib/gdrive.ts.
